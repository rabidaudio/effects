	(text "3rd order multiple-feedback LPF\nwith 3.2V DC offset and DC gain K of -1\n\nNOTE=could apply a DC gain to scale input to proper 120mV level\n\nAssuming input is already 120mV_rms (-14dBu), the total bandwidth of the\nBDD is 50dB so we need at least 50db of rejection at 1/2 the lowest clock\nfrequency (5kHz). Note that some rejection is already happining with the\nbandpass of the previous stage.\n\nhttp://sim.okawa-denshi.jp/en/OPtazyuLowkeisan.htm\n"
		(exclude_from_sim no)
		(at 156.21 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "7d573b61-43f9-4851-8acb-841e6b9f936e")
	)
