	(text "f0 = filters.passive_hp()\nf0.realize(c1=\"1u\", r2=\"100M\")\nf1 = filters.passive_lp()\nf1.realize(r1=\"43k\", c2=\"1n\")\nf2 = filters.passive_lp()\nf2.realize(r1=\"39k\", c2=\"1.5n\")\nf3 = filters.multiple_feedback_lp()\nf3.realize(r1=\"39k\", c2=\"1.5n\", r3=\"33k\", r4=\"120k\", c5=\"100p\")\nrr = f0.cascade(f1).cascade(f2).cascade(f3)\nrr.plot_bode()\ndb(np.abs(aa.evaluate(4000))) # -2db\ndb(np.abs(aa.evaluate(5000))) # -3.6db\ndb(np.abs(aa.evaluate(10000))) # -17db"
		(exclude_from_sim no)
