	(text "passive: -30 dBu to -12 dBu (68mVpp to 552mVpp)\nactive:  -10 dBu to +4 dBu (693mVpp to3.4Vpp)\n\nBBD input: 120mV RMS = -16.198 dbU = 0.339 Vpp\n\nCompressor outputs ~45mVpp. Thus,\nInput gain: 500mVpp to 5Vpp -> 10x (then scaled down by compressor knob)\nMakeup gain: 45mVpp to 500mVpp -> 10x"
		(exclude_from_sim no)
		(at 145.415 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9d24ee2c-5dc3-422d-a033-f97c0a618892")
	)
	(text "K=5-20"
		(exclude_from_sim no)
		(at 73.66 57.785 0)
