	(text "Diff amp, subtracting BP signal\nfrom original signal to get notch signal"
		(exclude_from_sim no)
		(at 210.82 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5cada8d4-c8b1-44a5-b439-3c447e1e9a04")
	)
	(text "2nd order LPF\nR1=9.1K:  Q=.707 Cutoff = 3162Hz\ndetermined imperically, tune RV1 to taste\ntradeoff is notch in the 2.5KHz range for effect bw"
		(exclude_from_sim no)
		(at 160.02 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a1fee690-7c07-4262-b878-35ec6910c9f3")
	)
	(text "2nd order HPF, Q=0.5\nAdjustable Cutoff: 10Hz - 1KHz"
		(exclude_from_sim no)
		(at 81.28 113.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a54c6357-bf4f-4cff-b501-c2b64217f2a0")
	)
	(text "from .core import db\n\ntone_splitter_hp = filters.sallen_key_hp()\n# An adjustable sub-butterworth filter (Q=0.5)\n# with a cutoff from ~10Hz to ~1kHz\n\n# 1kHz\n# tone_splitter_hp.realize(c1=\"150n\", c2=\"150n\", r3=\"1k\", r4=\"1k\")\n# 100Hz\ntone_splitter_hp.realize(c1=\"150n\", c2=\"150n\", r3=\"11k\", r4=\"11k\")\n# 10Hz\n# tone_splitter_hp.realize(c1=\"150n\", c2=\"150n\", r3=\"101k\", r4=\"101k\")\n# tone_splitter_hp.plot_bode()\ndb(np.abs(tone_splitter_hp.evaluate(10)))\ndb(np.abs(tone_splitter_hp.evaluate(100)))\ndb(np.abs(tone_splitter_hp.evaluate(1000)))\n\n# upper bound of bandpass filter. fc=3.162kHz, Q=0.707 (butterworth)\ntone_splitter_lp = filters.sallen_key_lp()\ntone_splitter_lp.realize(r1=\"9.1k\", r2=\"5.6k\", c3=\"10n\", c4=\"4.7n\")\n# adjusted for less novel parts\ntone_splitter_lp.realize(r1=\"10k\", r2=\"5.6k\", c3=\"10n\", c4=\"4.7n\")\n# tone_splitter_lp.plot_bode()\ndb(np.abs(tone_splitter_lp.evaluate(3162))) # -3.2db\n\ntone_splitter = tone_splitter_hp.cascade(tone_splitter_lp)\ntone_stopband = db(np.abs(tone_splitter.evaluate(5_000))) # -9.3dB\n# tone_splitter.plot_bode()"
		(exclude_from_sim no)
		(at 16.51 133.985 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ea96dcec-09e8-46c6-ad1b-054c3ff8ed30")
	)
